   "source": [
    "# Oplossen DV: dT/T = x / (1-x^2) dx\n",
    "# ln(T) = -0.5 * ln(1-x^2) + C\n",
    "# T = C * (1-x^2)^(-0.5)\n",
    "# Bij x=0 is T = T_start.\n",
    "# Dus: T(x) = T_start / sqrt(1 - x^2)\n",
    "\n",
    "# We moeten x berekenen vanuit volumes1.\n",
    "# V1 = V0(1+x) -> x = V1/V0 - 1. Maar volume is oppervlakte.\n",
    "# In code: volumes1[0] is startvolume V0.\n",
    "V0_start = volumes1[0]\n",
    "x_vals = (volumes1 / V0_start) - 1\n",
    "T_start = temperatures1[0]\n",
    "\n",
